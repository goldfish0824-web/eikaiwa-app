{
  "name": "eikaiwa-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "node tools/sync-embedded.js --check && node --test \"test/*.test.js\" && wrangler deploy",
    "passwords": "wrangler secret put PASSWORDS < passwords.local.json",
    "tail": "wrangler tail",
    "sync": "node tools/sync-embedded.js",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0"
  }
}
